// WiFi Configuration
#define WIFI_SSID "your-wifi-ssid"
#define WIFI_PASSWORD "your-wifi-password"

// MQTT Broker (your server running Docker)
#define MQTT_BROKER_IP "192.168.1.100"  // Change to your server IP
#define MQTT_PORT 1883

// Note: Device ID is now auto-generated from the ESP32's unique chip ID
// Each ESP32 will have a unique ID like "A1B2C3D4"

// Shared with the server's FIRMWARE_TOKEN. Firmware images contain the WiFi
// credentials above, so the server will not hand one out without this.
#define FIRMWARE_TOKEN "change-me-and-put-the-same-value-in-lumina-env"
