# The address a STRIP fetches firmware from, needed for OTA. Not derivable by
# the API, which is on a bridged Docker network and knows only its own 172.x
# address - use the host's LAN address and the API's published port.
FIRMWARE_BASE_URL=http://192.168.1.55:8001
